<%- include('partials/head', { title: 'Admin — MailButler', addr: null }) %>

<section class="panel admin">
  <div class="msg-head">
    <h1>Admin</h1>
    <form method="post" action="/admin/logout" class="inline"><button class="btn small ghost">Sign out</button></form>
  </div>

  <% if (notice) { %><p class="notice"><%= notice %></p><% } %>
  <% if (exposed) { %>
    <p class="warn">
      This instance is bound to <code><%= config.host %></code>, not loopback. Anyone who can reach
      this host can read every mailbox. Only do this on an isolated lab network.
    </p>
  <% } %>

  <div class="stat-row">
    <div class="stat"><b><%= stats.messages %></b><span>messages</span></div>
    <div class="stat"><b><%= stats.mailboxes %></b><span>mailboxes</span></div>
    <div class="stat"><b><%= stats.attachments %></b><span>attachments</span></div>
    <div class="stat"><b><%= fmtBytes(usage.bytes) %></b><span><%= usage.count %> blobs on disk</span></div>
  </div>

  <h2>Which domains do we accept mail for?</h2>
  <form method="post" action="/admin/policy" class="policy-form">
    <label><input type="radio" name="policy" value="any" <%= policy === 'any' ? 'checked' : '' %>>
      <b>Any domain</b> &mdash; act as a catch-all. Every recipient is accepted.</label>
    <label><input type="radio" name="policy" value="allowlist" <%= policy === 'allowlist' ? 'checked' : '' %>>
      <b>Allowlist only</b> &mdash; refuse anything else with a 550, the way a real MTA would.</label>
    <button class="btn small" type="submit">Save policy</button>
  </form>

  <div class="domains <%= policy === 'any' ? 'dim' : '' %>">
    <form method="post" action="/admin/domains/add" class="addr-form small">
      <input type="text" name="domain" placeholder="lab.local, corp.test" aria-label="Domain to accept">
      <button type="submit">Add domain</button>
    </form>
    <% if (domains.length) { %>
      <ul class="chips">
        <% domains.forEach(function (d) { %>
          <li>
            <code><%= d %></code>
            <form method="post" action="/admin/domains/remove" class="inline">
              <input type="hidden" name="domain" value="<%= d %>">
              <button class="chip-x" title="Remove <%= d %>">&times;</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="hint">No domains yet. While the policy is "allowlist", an empty list refuses everything.</p>
    <% } %>
  </div>

  <h2>Listeners</h2>
  <table class="kv">
    <tr><th>SMTP</th><td><code><%= config.host %>:<%= config.smtpPort %></code> &mdash; no AUTH, no TLS</td></tr>
    <tr><th>Web</th><td><code>http://<%= config.host %>:<%= config.httpPort %></code></td></tr>
    <tr><th>Max message</th><td><%= fmtBytes(config.maxSize) %></td></tr>
    <tr><th>Data directory</th><td><code><%= config.dataDir %></code></td></tr>
  </table>
  <p class="hint">Ports and binding are set at start time: <code>mailbutler serve --smtp-port 25 --http-port 80 --host 0.0.0.0</code></p>

  <h2>Mailboxes</h2>
  <% if (mailboxes.length) { %>
    <table class="mailboxes">
      <thead><tr><th>Address</th><th>Received</th><th>Sent</th><th>Last activity</th><th></th></tr></thead>
      <tbody>
        <% mailboxes.forEach(function (mb) { %>
          <tr>
            <td><code><%= mb.address %></code></td>
            <td><%= mb.received %></td>
            <td><%= mb.sent %></td>
            <td><%= fmtDate(mb.last_at) %></td>
            <td class="row-actions">
              <form method="post" action="/" class="inline">
                <input type="hidden" name="address" value="<%= mb.address %>">
                <button class="btn tiny ghost" title="Read this mailbox">Open</button>
              </form>
              <form method="post" action="/admin/mailbox/delete" class="inline">
                <input type="hidden" name="address" value="<%= mb.address %>">
                <button class="btn tiny ghost">Delete mail</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="hint">No mail yet, so no mailboxes exist.</p>
  <% } %>

  <h2>Maintenance</h2>
  <div class="maint">
    <form method="post" action="/admin/gc" class="inline">
      <button class="btn small">Reclaim space</button>
      <span class="hint inline">Deletes stored files no message points at any more.</span>
    </form>
    <form method="post" action="/admin/purge" class="danger-form">
      <label>Reset the lab: delete every message and every stored file.</label>
      <input type="text" name="confirm" placeholder="Type PURGE to confirm" aria-label="Type PURGE to confirm">
      <button class="btn small danger" type="submit">Purge all mail</button>
    </form>
  </div>
</section>

<%- include('partials/foot') %>
