<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="color-scheme" content="light dark">
<title><%= typeof title !== 'undefined' ? title : 'Tinpost' %></title>
<link rel="stylesheet" href="/static/app.css">
<link rel="icon" type="image/png" sizes="32x32" href="/static/icon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/static/icon-180.png">
<script>
  // Applied before first paint so a chosen theme never flashes the other one.
  try {
    var t = localStorage.getItem('mb.theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
</head>
<body>
<%- include('icons') %>
<header class="topbar">
  <%# The version rides beside the wordmark, outside the link, so the product still
      reads and copies as "Tinpost" on its own. %>
  <div class="brand-wrap">
    <a class="brand" href="<%= locals.addr ? '/mail' : '/' %>"><img class="brand-mark mark-light" src="/static/icon-64.png" alt="" width="22" height="22"
      ><img class="brand-mark mark-dark" src="/static/icon-64-dark.png" alt="" width="22" height="22"
      >Tin<span class="brand-dot" aria-hidden="true">·</span><span class="brand-tail">post</span></a>
    <span class="brand-version" title="Tinpost version <%= version %>">v<%= version %></span>
  </div>
  <nav>
    <% if (locals.addr) { %>
      <%# Compose lives on the inbox, beside the list it acts on. A second copy up
          here was the same action twice on the same screen. %>
      <span class="who" title="The mailbox you are reading"><%= addr %></span>
      <a class="nav-link subtle" href="/?switch=1">Switch</a>
      <form method="post" action="/signout" class="inline"><button class="linkish">Sign out</button></form>
    <% } %>
    <a class="nav-link <%= locals.navTimeline ? 'on' : 'subtle' %> nav-timeline" href="/timeline"<%- locals.navTimeline ? ' aria-current="page"' : '' %>>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-timeline"/></svg>Timeline
    </a>
    <a class="nav-link subtle" href="/admin">Admin</a>
    <button type="button" class="theme-btn" data-theme-toggle
            title="Switch between light and dark" aria-label="Switch between light and dark">
      <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-sun"/></svg>
      <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-moon"/></svg>
    </button>
  </nav>
</header>
<main<%- locals.full ? ' class="wide full"' : locals.wide ? ' class="wide"' : '' %>>
