<% const title = 'Tinpost' %>
<%- include('partials/head', { title, addr: null }) %>

<section class="hero">
  <h1>Which mailbox do you want to read?</h1>
  <p class="lede">
    Type any address. There is no sign-up and no password &mdash; a mailbox exists the
    moment mail is addressed to it.
  </p>

  <form method="post" action="/" class="addr-form" autocomplete="off">
    <div class="combo" data-mailbox-combo>
      <%# type="text", not "email": an email input forbids setSelectionRange, which the
          inline completion needs. The server validates the address either way. %>
      <input type="text" inputmode="email" name="address" placeholder="alice@lab.local" required autofocus
             value="<%= addr || '' %>" aria-label="Email address to read"
             role="combobox" aria-expanded="false" aria-autocomplete="both"
             aria-controls="mailbox-options" autocomplete="off" spellcheck="false">
      <ul class="combo-list" id="mailbox-options" role="listbox" hidden></ul>
    </div>
    <button type="submit">Open mailbox</button>
  </form>
  <p class="hint combo-hint">
    Type any address. Existing mailboxes complete as you go &mdash; a new one is created
    the moment mail arrives for it.
  </p>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <% if (locals.portNotice) { %>
    <p class="warn port-warn">
      <strong><%= portNotice.headline %></strong>
      <%= portNotice.detail %>
      Point senders at <code>127.0.0.1:<%= smtpPort %></code>.
    </p>
  <% } %>

  <div class="policy-note">
    <% if (policy === 'any') { %>
      Accepting mail for <strong>any domain</strong>.
    <% } else { %>
      Accepting mail only for:
      <% if (domains.length) { %>
        <% domains.forEach(function (d, i) { %><code><%= d %></code><%= i < domains.length - 1 ? ' ' : '' %><% }) %>
      <% } else { %>
        <em>no domains configured yet &mdash; all mail is being refused.</em>
      <% } %>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
