<%- include('partials/head', { title: 'Change admin password — MailButler', addr: null }) %>

<section class="panel narrow">
  <h1><%= mustChange ? 'Choose your admin password' : 'Change admin password' %></h1>

  <% if (mustChange) { %>
    <p class="lede">
      You are signed in with the temporary password MailButler generated at first
      start. Choose your own before going any further &mdash; the generated one was
      printed to the server log in plain text, so it should not stay in use.
    </p>
  <% } else { %>
    <p class="lede">Changing this signs out every admin session, including this one.</p>
  <% } %>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <form method="post" action="/admin/password" autocomplete="off">
    <label class="field">
      <span><%= mustChange ? 'Temporary password' : 'Current password' %></span>
      <input type="password" name="current" required autofocus
             placeholder="<%= mustChange ? 'The one from the server log' : '' %>">
    </label>

    <label class="field">
      <span>New password</span>
      <input type="password" name="next" required minlength="8" placeholder="At least 8 characters">
    </label>

    <label class="field">
      <span>New password again</span>
      <input type="password" name="confirm" required minlength="8">
    </label>

    <div class="actions">
      <button type="submit" class="btn primary">Set password</button>
      <% if (!mustChange) { %><a class="btn ghost" href="/admin">Cancel</a><% } %>
    </div>
  </form>
</section>

<%- include('partials/foot') %>
