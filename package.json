{
  "name": "tinpost",
  "version": "0.7.9",
  "description": "A self-contained mail server with a web interface for lab environments. Supports a message timeline, live SMTP logs viewing, ICAP scanning and gateway relay",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/cventour/tinpost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cventour/tinpost.git"
  },
  "bugs": {
    "url": "https://github.com/cventour/tinpost/issues"
  },
  "bin": {
    "tinpost": "src/cli.js"
  },
  "main": "./src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js serve",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/view": "^11.0.0",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.0.10",
    "smtp-server": "^3.13.6"
  },
  "keywords": [
    "smtp",
    "mail",
    "mail-server",
    "webmail",
    "email",
    "lab",
    "testing",
    "security-testing",
    "icap",
    "phishing-simulation",
    "mailhog",
    "mailpit",
    "offline"
  ]
}
